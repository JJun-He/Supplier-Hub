  "findings": {
    "catalogMissingClient": "A enabled but only B registered: no startup exception; B stored once",
    "catalogDuplicateClient": "A registered twice: two replace calls within one synchronization",
    "catalogMismatch": "A client returns B snapshot while B disabled: B passed to store",
    "internalSearchBug": "IllegalStateException from A client => PARTIAL, UNKNOWN; one valid B offer retained",
    "normalizerBug": "NPE => rejected item; IllegalStateException => propagated",
    "api500": "Default JSON status=500, no code field, injected private message absent"
  },
